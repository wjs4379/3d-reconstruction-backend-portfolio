# Example values only. Copy this file locally; never commit real secrets.
MYSQL_DATABASE=spatial_asset_db
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
DB_URL=jdbc:mysql://mysql:3306/spatial_asset_db?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useUnicode=true
DB_USERNAME=gp_app
DB_PASSWORD=replace-with-a-strong-app-password
JWT_SECRET=replace-with-at-least-32-bytes-of-random-secret
JWT_ISSUER=gp-backend

# Optional public Google web client ID. Production Compose reuses this value
# for the frontend VITE_GOOGLE_CLIENT_ID build arg; rebuild web after changes.
GOOGLE_CLIENT_ID=
# Kakao numeric app ID, not a REST API key or JavaScript key.
KAKAO_APP_ID=
# Browser authorize uses the same public REST identifier; token exchange keeps the secret on the server.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# Exact registered frontend callback; HTTPS in production. Never accepted from request input.
KAKAO_REDIRECT_URI=http://localhost:5173/oauth/callback/kakao
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_PUBLIC_BASE_URL=http://localhost:8080
APP_HOST_PORT=8080
# Default loopback. For a separate private GPU host, use the actual BE private IP and restrict its security group.
APP_BIND_ADDRESS=127.0.0.1

# local = durable Compose media_data volume. s3 = private bucket + workload IAM role.
MEDIA_MODE=local
MEDIA_S3_BUCKET=
AWS_REGION=ap-northeast-2
# Comma-separated admin-reviewed legacy model IDs; empty disables legacy imports.
APPROVED_LEGACY_MODEL_IDS=

# Address coordinates are resolved on the server; never place this REST key in VITE_*.
KAKAO_LOCAL_REST_API_KEY=

# Existing AI pipeline. Enable only after service/GPU/model and callback configuration.
AI_PIPELINE_ENABLED=false
AI_SERVICE_KEY=
# Origin reachable from the AI host; same value as AI-side AI_BACKEND_BASE_URL.
APP_BACKEND_BASE_URL=http://127.0.0.1:8080
# Persistent analysis and correction/reconstruction dispatch. Keep off until legacy pending events are reviewed.
OUTBOX_WORKER_ENABLED=false
AI_SERVER_BASE_URL=http://127.0.0.1:8000
APP_WEBHOOK_URL=http://127.0.0.1:8080/api/internal/ai/webhook

# Same HTTPS domain serves the SPA and /api in compose.prod.yaml; these are placeholders.
API_DOMAIN=api.example.com
TLS_DIRECTORY=/etc/gp-backend/tls

# Public frontend build inputs for compose.prod.yaml; changing them requires a web image rebuild.
VITE_KAKAO_REST_API_KEY=
# Empty preserves the frontend OSM default; set a suitable tile provider for production traffic.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
