# Documentation only. Generate a private 0600 file with:
# python3 scripts/real_integration.py prepare --runtime ABSOLUTE_PRIVATE_RUNTIME
# Never source this file. Values are literal KEY=VALUE without quotes/expansion.
# Fill real Kakao values in the generated private file, not in this example.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8083
DB_URL=jdbc:mysql://127.0.0.1:3327/gp_estate_real_integration?sslMode=REQUIRED&serverTimezone=Asia/Seoul
DB_USERNAME=gp_integration
DB_PASSWORD=
JWT_ISSUER=gp-real-integration
JWT_SECRET=
AI_SERVICE_KEY=
MEDIA_MODE=local
MEDIA_LOCAL_DIRECTORY=ABSOLUTE_PRIVATE_RUNTIME/media
APP_PUBLIC_BASE_URL=http://127.0.0.1:8083
APP_BACKEND_BASE_URL=http://127.0.0.1:8083
APP_WEBHOOK_URL=http://127.0.0.1:8083/api/internal/ai/webhook
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
KAKAO_APP_ID=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://127.0.0.1:5173/oauth/callback/kakao
KAKAO_LOCAL_REST_API_KEY=
GOOGLE_CLIENT_ID=
AI_SERVER_BASE_URL=http://127.0.0.1:18001
# Stage 1: both false. Stage 2: AI true/worker false after verified managed SSH
# and strict readiness checks. The helper never sends an AI key to an unmanaged port.
# Stage 3: both true requires real GPU + loaded non-mock registration checkpoints
# through that same verified tunnel, before dispatching actual AI jobs.
AI_PIPELINE_ENABLED=false
OUTBOX_ENABLED=true
OUTBOX_WORKER_ENABLED=false
