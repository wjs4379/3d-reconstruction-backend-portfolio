# Copy outside Git to /etc/metaround/aws.env and chmod 600.
API_DOMAIN=estate.your-domain.example
AWS_REGION=ap-northeast-2
# Private RDS DNS, not an IP. No DB credentials in this URL.
DB_URL=jdbc:mysql://your-db.ap-northeast-2.rds.amazonaws.com:3306/spatial_asset_db?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&sslMode=VERIFY_IDENTITY&trustCertificateKeyStoreUrl=file:/etc/rds/rds-truststore.p12&trustCertificateKeyStoreType=PKCS12&trustCertificateKeyStorePassword=changeit
DB_USERNAME=metaround_app
DB_PASSWORD=replace-with-a-random-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
KAKAO_APP_ID=replace-with-numeric-app-id
KAKAO_REST_API_KEY=replace-with-your-public-kakao-rest-key
# Client secret stays on Spring only; never place it in VITE variables.
KAKAO_CLIENT_SECRET=replace-with-your-server-only-kakao-client-secret
# Address key stays on the server.
KAKAO_LOCAL_REST_API_KEY=replace-with-your-server-address-key
# Kakao public REST API client identifier used by browser code exchange.
VITE_KAKAO_REST_API_KEY=replace-with-your-public-kakao-rest-key
# Optional public Google web client ID; shared by the server and frontend build.
# Compose supplies VITE_GOOGLE_CLIENT_ID from this value; rebuild web after changes.
GOOGLE_CLIENT_ID=
MEDIA_S3_BUCKET=replace-with-your-private-bucket-name
RDS_TRUST_DIRECTORY=/etc/metaround/rds
TLS_DIRECTORY=/etc/metaround/letsencrypt
ACME_WEBROOT=/var/lib/metaround/acme
APP_BIND_ADDRESS=127.0.0.1
# Existing AI stays optional until the real GPU host returns. Existing GLBs still work.
AI_PIPELINE_ENABLED=false
OUTBOX_WORKER_ENABLED=false
AI_SERVICE_KEY=
AI_SERVER_BASE_URL=http://127.0.0.1:8000
APP_BACKEND_BASE_URL=http://127.0.0.1:8080
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
