# Public-only preview: copy outside Git to /etc/metaround/aws-cloudfront-local.preview.env and chmod 600.
# Use aws.sh TASK /etc/metaround/aws-cloudfront-local.preview.env cloudfront-local --preview-without-oauth.
# No fake login or management tokens. Real login/address require all production keys later.
# Existing MySQL remains owned by its original Compose project. Do not mount/recreate its volume.
# Create metaround_estate_v5 + a dedicated schema-only user after backing up the original DB.
# Public HTTPS terminates at CloudFront; origin HTTP is restricted by SG + the secret.
API_DOMAIN=replace-with-distribution.cloudfront.net
CLOUDFRONT_ORIGIN_SECRET=replace-with-64-random-hex-characters
AWS_REGION=ap-northeast-2
# Same-host Docker DNS mysql, new schema ONLY. No DISABLED TLS or public-key retrieval.
DB_URL=jdbc:mysql://mysql:3306/metaround_estate_v5?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&sslMode=VERIFY_CA&trustCertificateKeyStoreUrl=file:/etc/mysql/mysql-truststore.p12&trustCertificateKeyStoreType=PKCS12&trustCertificateKeyStorePassword=changeit
DB_USERNAME=metaround_estate_app
DB_PASSWORD=replace-with-a-random-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
EXISTING_DB_NETWORK=replace-with-existing-mysql-network
# Public CA only, prepared by prepare-local-mysql-trust.sh; mounted read-only.
MYSQL_TRUST_DIRECTORY=/etc/metaround/mysql
KAKAO_APP_ID=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_LOCAL_REST_API_KEY=
VITE_KAKAO_REST_API_KEY=
GOOGLE_CLIENT_ID=
MEDIA_S3_BUCKET=replace-with-your-private-bucket-name
APP_BIND_ADDRESS=127.0.0.1
AI_PIPELINE_ENABLED=false
OUTBOX_WORKER_ENABLED=false
AI_SERVICE_KEY=
AI_SERVER_BASE_URL=http://127.0.0.1:8000
APP_BACKEND_BASE_URL=http://127.0.0.1:8080
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
