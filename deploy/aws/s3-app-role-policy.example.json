{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VerifiedMediaRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::REPLACE_MEDIA_BUCKET/assets/*"
    },
    {
      "Sid": "VerifiedMediaWrite",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_MEDIA_BUCKET/assets/*"
    },
    {
      "Sid": "TemporaryUploadAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_MEDIA_BUCKET/staging/*"
    }
  ]
}
